{
  "manifest_version": 3,
  "name": "PromptCard AI - Image to Prompt",
  "key": "",
  "version": "1.19.6",
  "description": "Transform images and screen selections into detailed, high-fidelity AI prompts with built-in analysis or your own compatible API.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://promptcard.supabase.umutdogan.space/*",
    "https://api.promptcard.umutdogan.space/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PromptCard AI - Image to Prompt",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}